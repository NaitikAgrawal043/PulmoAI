# ==========================================
# PulmoAI - Root Git Ignore
# ==========================================

# Environment variables & secrets (NEVER commit real keys)
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
*/node_modules/
venv/
*/venv/
env/
*/env/

# Python cache & artifacts
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*/build/

# Uploaded patient CT scans / temporary analysis files
backend/uploads/*
!backend/uploads/.gitkeep

# Testing & Coverage
coverage/
*/coverage/
.pytest_cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
