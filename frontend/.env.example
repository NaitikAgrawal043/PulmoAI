# React Dev Server Port
PORT=3000

# Prevent automatic browser window popups during development
BROWSER=none

# PulmoAI Backend API URL (for CT Scan Analysis)
REACT_APP_API_URL=http://localhost:5001/api

# Medical Chatbot Python Service URL (from medical-chatbot folder)
# Local development: http://localhost:5000
# Deployed (e.g. Render/Railway): https://<your-pulmoai-chatbot>.onrender.com
REACT_APP_CHATBOT_URL=http://localhost:5000
