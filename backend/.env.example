# Server Port
PORT=5001

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Python Medical Chatbot RAG Microservice URL
# Local development: http://localhost:5000/ask
# Deployed (e.g., Render/Railway): https://<your-pulmoai-chatbot>.onrender.com/ask
# IMPORTANT: In cloud deployment, do NOT use localhost; use your deployed Python service URL!
RAG_SERVICE_URL=http://localhost:5000/ask

# Optional Keys for direct RAG
PINECONE_API_KEY=your_pinecone_api_key_here
GROQ_API_KEY=your_groq_api_key_here
